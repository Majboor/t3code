{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_HTTP_URL",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "T3CODE_LOG_WS_EVENTS",
    "T3CODE_MODE",
    "T3CODE_PORT",
    "T3CODE_HOST",
    "T3CODE_NO_BROWSER",
    "T3CODE_HOME",
    "T3CODE_AUTH_TOKEN",
    "T3CODE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD",
    "T3CODE_LOCAL_PASSWORD_AUTH",
    "T3CODE_UNSAFE_NO_AUTH",
    "T3CODE_BASIC_AUTH_USER",
    "T3CODE_BASIC_AUTH_PASSWORD",
    "T3CODE_BASIC_AUTH_REALM",
    "T3CODE_SUPABASE_PROJECT_URL",
    "T3CODE_SUPABASE_ANON_KEY",
    "T3CODE_SUPABASE_JWT_AUDIENCE",
    "T3CODE_SUPABASE_SERVICE_ROLE_SECRET_NAME",
    "T3CODE_DESKTOP_WS_URL",
    "T3CODE_TRACE_MIN_LEVEL",
    "T3CODE_TRACE_TIMING_ENABLED",
    "T3CODE_TRACE_FILE",
    "T3CODE_TRACE_MAX_BYTES",
    "T3CODE_TRACE_MAX_FILES",
    "T3CODE_TRACE_BATCH_WINDOW_MS",
    "T3CODE_OTLP_TRACES_URL",
    "T3CODE_OTLP_METRICS_URL",
    "T3CODE_OTLP_EXPORT_INTERVAL_MS",
    "T3CODE_OTLP_SERVICE_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
